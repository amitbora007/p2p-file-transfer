# ──────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ──────────────────────────────────────────────

# PORT for local dev server (default: 3000)
PORT=3000

# ──────────────────────────────────────────────
# VERCEL (frontend) — set these in Vercel dashboard
# ──────────────────────────────────────────────

# URL of your Render signaling server
# e.g. https://p2p-signaling.onrender.com
VITE_SOCKET_URL=

# ──────────────────────────────────────────────
# RENDER (signaling server) — set these in Render dashboard
# ──────────────────────────────────────────────

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
# e.g. https://p2p-transfer.vercel.app
CORS_ORIGIN=
