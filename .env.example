# ──────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ──────────────────────────────────────────────

# PORT for local dev server (default: 3000)
PORT=3000

# Node environment mode (production / development)
NODE_ENV=production

# ──────────────────────────────────────────────
# OPTIONAL: CROSS-DOMAIN SETTINGS
# (Only needed if frontend and backend are hosted on different domains)
# ──────────────────────────────────────────────

# Optional custom Socket.IO signaling URL (defaults to window.location.origin)
# VITE_SOCKET_URL=https://your-service.onrender.com

# Optional CORS origins (comma-separated, defaults to "*" if omitted)
# CORS_ORIGIN=https://your-service.onrender.com

# ──────────────────────────────────────────────
# OPTIONAL: CUSTOM TURN RELAY CONFIGURATION
# (The app includes free built-in OpenRelay TURN servers by default)
# ──────────────────────────────────────────────
# VITE_TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# VITE_TURN_USERNAME=myuser
# VITE_TURN_PASSWORD=mypassword
